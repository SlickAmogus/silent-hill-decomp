<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>@SH_IOS_EXECUTABLE@</string>
	<key>CFBundleIdentifier</key>
	<string>@SH_IOS_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Silent Hill</string>
	<key>CFBundleDisplayName</key>
	<string>Silent Hill</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- Xcode injects these; a CMake/Ninja build does not, and without them
	     installers reject the bundle outright. CFBundleSupportedPlatforms is the
	     one that matters: Sideloadly reads it to tell an iOS app from a macOS
	     one, and failed with "This does not look like valid iOS app!" when it
	     was absent. The DT* keys are what codesign and the installd on-device
	     check consult for the SDK a bundle was built against. -->
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>@SH_IOS_PLATFORM@</string>
	</array>
	<key>DTPlatformName</key>
	<string>@SH_IOS_PLATFORM_NAME@</string>
	<key>DTSDKName</key>
	<string>@SH_IOS_SDK_NAME@</string>
	<key>DTPlatformVersion</key>
	<string>@SH_IOS_SDK_VERSION@</string>
	<key>DTCompiler</key>
	<string>com.apple.compilers.llvm.clang.1_0</string>

	<!-- The user supplies their own disc image. These two keys are what put the
	     app's Documents directory in Files.app, which is the only practical way
	     to get a multi-hundred-megabyte BIN/CUE onto the device. Without them
	     there is no way in at all. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- The game renders 4:3 and the port's cull bounds are derived from the
	     surface size, so let it have the whole screen and never rotate. SDL is
	     told the same thing via SDL_HINT_ORIENTATIONS before SDL_Init; the hint
	     wins at runtime, this is what the launcher and Springboard read. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Without a launch storyboard iOS runs the app in a 320x480 compatibility
	     box, letterboxed on every modern device. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- The port has real mouse/pointer paths (cursor puzzles, the clickable
	     main menu). Without this key UIKit withholds indirect pointer events and
	     logs "You need UIApplicationSupportsIndirectInputEvents in your
	     Info.plist for mouse support", so a paired trackpad or mouse does
	     nothing. Touch is unaffected either way. -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>MinimumOSVersion</key>
	<string>@SH_IOS_DEPLOYMENT_TARGET@</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<!-- iOS 27 refuses to launch an app built with its SDK unless it adopts the
	     UIScene lifecycle (UIKit traps in
	     _UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption). SDL 2
	     has no scene support, so ios_port/src/ios_scene.m provides the
	     delegate named here and moves SDL's windows onto the scene. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>SHSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
