/*
 * vs.vs.cg - 2D screen-space passthrough vertex shader for the NV2A backend.
 *
 * IMPORTANT: NV2A's vp20 vertex program (with pbkit's setup) outputs WINDOW
 * coordinates directly — pbkit applies no viewport scale/offset, so the VS must
 * emit pixels (x: 0..640, y: 0..480 with y down), NOT normalized device coords.
 * (The nxdk `mesh` sample bakes the viewport matrix into m_proj for the same
 * reason.) Input position is already in screen pixels — the form PSX libgpu
 * primitives take after the software GTE projects them — so this is a true
 * passthrough. Diffuse colour is passed to the pixel shader for modulation;
 * specular carries the per-vertex FOG term (fogColor * fogFactor) which the
 * final register combiner ADDS to tex*diffuse (out = tex*col*(1-f) + fogC*f
 * with the (1-f) pre-folded into col by gpu_xbox.c).
 */
struct vIn {
	float4 pos  : POSITION;
	float4 col  : DIFFUSE;
	float4 spec : SPECULAR;
	float4 tex  : TEXCOORD0;
};

struct vOut {
	float4 pos  : POSITION;
	float4 col  : COLOR0;
	float4 spec : COLOR1;
	float4 tex0 : TEXCOORD0;
};

vOut main(vIn I)
{
	vOut o;
	o.pos.x = I.pos.x;
	o.pos.y = I.pos.y;
	o.pos.z = I.pos.z;
	o.pos.w = 1.0;
	o.col   = I.col;
	o.spec  = I.spec;
	o.tex0  = I.tex;
	return o;
}
