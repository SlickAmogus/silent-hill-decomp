/*
 * vs.vs.cg - 2D screen-space passthrough vertex shader for the NV2A backend.
 *
 * Input position is in SCREEN PIXELS (x: 0..640, y: 0..480) — the form PSX
 * libgpu primitives arrive in after the software GTE has projected them. Maps
 * straight to clip space; no perspective (PSX 2D prims are already projected).
 * Screen size is baked in (640x480) so there is no uniform-constant to upload.
 * Diffuse colour is passed through; the pixel shader modulates the texture by it.
 */
struct vIn {
	float4 pos : POSITION;
	float4 col : DIFFUSE;
	float4 tex : TEXCOORD0;
};

struct vOut {
	float4 pos  : POSITION;
	float4 col  : COLOR;
	float4 tex0 : TEXCOORD0;
};

vOut main(vIn I)
{
	vOut o;
	o.pos.x = I.pos.x * (2.0 / 640.0) - 1.0;
	o.pos.y = 1.0 - I.pos.y * (2.0 / 480.0);
	o.pos.z = I.pos.z;
	o.pos.w = 1.0;
	o.col   = I.col;
	o.tex0  = I.tex;
	return o;
}
