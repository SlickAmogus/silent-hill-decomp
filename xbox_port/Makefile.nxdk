# Silent Hill 1 - Original Xbox (NXDK / NV2A) port
#
# GNU-make build wrapping the nxdk toolchain -> default.xbe. Invoke via
# build_xbox.sh (sets NXDK_DIR + PATH + scrubs host MSVC INCLUDE/LIB).
#
# MILESTONE 1: build only the platform shell (main_xbox.c + log shim) to a
# booting black-screen xbe. Shared game code + reused pc_port files get added to
# SRCS in the next milestone.

XBE_TITLE = SilentHill
NXDK_DIR  ?= $(CURDIR)/nxdk
# GEN_XISO intentionally unset: the default target then builds only default.xbe
# (boots directly in xemu / via HDD). Packing an .iso pulls in nxdk's extract-xiso
# host tool, which is built with CMake->gcc and hits the same temp-file bug as the
# other host tools; wire it up (with CXX=clang++) when an ISO is actually needed.

# nxdk-cc subprocesses need NXDK_DIR; MSYS2 make does not always propagate it.
export NXDK_DIR

# --- Repo layout ------------------------------------------------------------
XBOX_PORT = $(CURDIR)
PCPORT    = $(CURDIR)/../pc_port
DECOMP    = $(CURDIR)/..
PSYCROSS  = $(PCPORT)/PsyCross

# --- Shared compile flags ---------------------------------------------------
# nxdk uses SEPARATE flag vars per language (NXDK_CFLAGS for .c, NXDK_CXXFLAGS
# for .cpp), so defines + include paths must go into BOTH or C++ TUs (e.g. the
# PsyCross GTE) won't see them.
#
# Xbox-specific game-code paths sit behind #ifdef SH_XBOX_PORT. (A shared
# SH_NATIVE_PORT macro for "not-PSX" fixes common to PC+Xbox is planned but not
# defined yet — it will be introduced when the first such fix is migrated.)
# SH_PC_PORT is the decomp's de-facto "native (non-PSX) port" switch: it selects
# the software-GTE bridge (gpu_gte_pc.h), C fallbacks for the MIPS-asm/cop2 bodies
# (inline_no_dmpsx.h etc.), and PSX-RAM-emulated addresses (FS_BUFFER/FS_MEM_BASE
# via PSX_ADDR) — ALL of which the Xbox (flat-address x86, software GTE, emulated
# PSX memory) needs exactly as the PC port does. The non-PC branches emit raw MIPS
# opcodes (`.word ...`) that assemble silently but crash on x86, so we MUST take the
# native paths. SH_XBOX_PORT marks the Xbox-specific deltas (GPU/audio/file-IO) and
# overrides SH_PC_PORT where the two native ports must differ.
SH_CPPFLAGS  = -DSH_XBOX_PORT -DSH_PC_PORT
# Game-code defines mirrored from the PC port's CMakeLists (target-only, NOT
# PsyCross): region select, skip the MIPS asm bodies (we use the C decomp),
# PGXP compiled out (no perspective-correction path on Xbox).
SH_CPPFLAGS += -DVER_USA -DSKIP_ASM -DUSE_PGXP=0
# PSX structs are gcc/MIPS-bitfield-packed and overlay disc data verbatim. clang's
# i386-pc-win32 target defaults to MSVC bitfield layout (new storage unit per type
# change) -> wrong sizes/offsets. Force GNU/Itanium packing to match PSX + the PC
# port (mingw gcc). Without this, every STATIC_ASSERT_SIZEOF on a bitfield struct
# fails and disc-backed structs read garbage.
SH_CPPFLAGS += -mno-ms-bitfields
# The decomp leans on gcc-permissive diagnostics (the PC build passes the gcc
# spellings via CMake). clang promotes several of these to hard errors, so silence
# them here to match the PC port's tolerance (implicit decls, K&R pointer/int
# punning, benign fn-pointer signature drift).
SH_CPPFLAGS += -Wno-implicit-function-declaration -Wno-implicit-int \
	-Wno-incompatible-function-pointer-types -Wno-incompatible-pointer-types \
	-Wno-int-conversion -Wno-pointer-to-int-cast -Wno-int-to-pointer-cast \
	-Wno-sign-compare -Wno-unused-variable -Wno-unused-function \
	-Wno-missing-braces -Wno-parentheses -Wno-tautological-constant-out-of-range-compare \
	-Wno-return-type -Wno-pointer-sign -Wno-microsoft-include
# Include order mirrors pc_port/CMakeLists.txt: PC/Xbox compat headers FIRST so
# they override the original psyq/ copies, then the decomp headers, then the
# PsyCross PSX-HAL headers (<libgte.h>/<libgpu.h> resolve here).
SH_CPPFLAGS += -I$(XBOX_PORT)/include
SH_CPPFLAGS += -I$(PCPORT)/include            # shared sh_log.h, psx_memory.h, gpu_gte_pc.h, ...
SH_CPPFLAGS += -I$(PCPORT)/include/psyq_compat # PC-adapted libgs.h (overrides psyq/)
SH_CPPFLAGS += -I$(PCPORT)/src                 # pc_port-relative includes (e.g. "main/...")
SH_CPPFLAGS += -I$(DECOMP)/include             # game headers: game.h, bodyprog/, main/, maps/
SH_CPPFLAGS += -I$(DECOMP)/include/decomp      # common.h, types.h, version.h, include_asm.h
SH_CPPFLAGS += -I$(PSYCROSS)/include/psx
SH_CPPFLAGS += -I$(PSYCROSS)/include

# Explicit nxdk include paths using make's $(NXDK_DIR): MSYS2 make.exe does not
# propagate NXDK_DIR into nxdk-cc's shell, so nxdk-cc's own -I${NXDK_DIR}/...
# flags would expand empty. (See Duke port build notes.)
SH_CPPFLAGS += -I$(NXDK_DIR)/lib/winapi
SH_CPPFLAGS += -I$(NXDK_DIR)/lib
SH_CPPFLAGS += -I$(NXDK_DIR)/lib/xboxrt/libc_extensions
SH_CPPFLAGS += -isystem $(NXDK_DIR)/lib/pdclib/include
SH_CPPFLAGS += -I$(NXDK_DIR)/lib/pdclib/platform/xbox/include
SH_CPPFLAGS += -I$(NXDK_DIR)/lib/xboxrt/vcruntime

NXDK_CFLAGS   += $(SH_CPPFLAGS)
NXDK_CXXFLAGS += $(SH_CPPFLAGS)

# The decomp uses C11 `static_assert` as a bare keyword. Map it to _Static_assert
# for C TUs only — applying it to C++ breaks libc++/std headers (matches the PC
# port's CMake, which scopes this define to C sources).
NXDK_CFLAGS += -Dstatic_assert=_Static_assert

# --- Reused PsyCross software GTE (platform-agnostic; replaces MIPS GTE asm) -
# inline_c.c = cop2 MTC2/CTC2/MFC2 interface, PsyX_GTE.cpp = the GTE math,
# libgte.c = high-level libgte API (RotTransPers, matrices), abs.c = helpers.
# (half_float.cpp is PGXP-only and unreferenced by the GTE -> excluded.)
GTE_SRCS = \
	$(PSYCROSS)/src/psx/inline_c.c \
	$(PSYCROSS)/src/psx/libgte.c \
	$(PSYCROSS)/src/psx/abs.c \
	$(PSYCROSS)/src/gte/PsyX_GTE.cpp

# --- Decomp game code (shared; PC bits sit behind #ifdef SH_PC_PORT) --------
# Recursive wildcard (pure make; no shell `find` dependency).
rwildcard = $(foreach d,$(wildcard $(1:=/*)),$(call rwildcard,$d,$2) $(filter $(subst *,%,$2),$d))

# Mirror pc_port/CMakeLists.txt source selection exactly:
#   main/   : all *.c except main.c (replaced by main_xbox.c) and memcpy.c (MIPS asm)
#   bodyprog: all *.c except bodyprog_80032D1C.c (dup symbol) and text_draw_jp.c (JP-only)
#   screens : all *.c except hp_safe1.c / s__safe2.c (JP anti-modchip, undefined on USA)
MAIN_SRCS     := $(filter-out %/main.c %/memcpy.c,$(wildcard $(DECOMP)/src/main/*.c))
BODYPROG_SRCS := $(filter-out %/bodyprog_80032D1C.c %/text_draw_jp.c,$(call rwildcard,$(DECOMP)/src/bodyprog,*.c))
SCREEN_SRCS   := $(filter-out %/hp_safe1.c %/s__safe2.c,$(call rwildcard,$(DECOMP)/src/screens,*.c))

# Map overlays: map0_s00 (the boot map) is linked UNPREFIXED, exactly as before.
# All other maps are statically linked too, but symbol-PREFIXED — see the
# "Additional statically-linked map overlays" block after the nxdk include.
# (Naive linking of all maps = 500+ symbol collisions: shared AI/particle/player
# code is #included into each map, so every map defines the same externs.)
MAP_DIR  := $(DECOMP)/src/maps/map0_s00
MAP_SRCS := \
	$(MAP_DIR)/player.c \
	$(MAP_DIR)/map0_s00_2.c \
	$(MAP_DIR)/map0_s00_anim_info.c \
	$(MAP_DIR)/map0_s00_events_data.c \
	$(MAP_DIR)/map0_s00_header.c \
	$(MAP_DIR)/Chara_Cheryl.c \
	$(MAP_DIR)/Chara_Stalker.c \
	$(MAP_DIR)/particle.c \
	$(PCPORT)/build_gen/extracted_data/map0_s00_extracted_data.c

# --- Reused pc_port sources (platform-agnostic) -----------------------------
# pc_port/src/*.c is mostly extracted anim-info data + rodata reformatters +
# PSX RAM emulation + math helpers, all platform-agnostic -> REUSE. Exclude the
# PC-HAL files (SDL/GL/OpenAL/dlopen/Windows) and the ones the Xbox port replaces:
#   main_pc            -> main_xbox.c
#   pc_config/console/crash/quicksave/combat/timing, dbg_overlay -> PC input/UI/cfg
#   warning_screen, hires_override -> PC-only screens (skip intros / GL hires)
#   fs_pc              -> Xbox uses fs_xbox.c + (later) xa_player sector reads
#   dll_loader, map_overlay_loader, map_registry -> PC overlay DLLs; Xbox static-links map0_s00
#   xa_player          -> xa_xbox.c (same XaPlayer_* surface; ring into the SPU mixer)
# (fmv/ and stubs/ are subdirs, excluded by the non-recursive glob; stubs added below.)
# (map7_s03_boss_motion: the pc_port copy is generated for x64 — its sh_scr
#  static assert (24B) and .set pool-offset aliases (24B stride, no '_' cdecl
#  prefix) are wrong for i386. xbox_port/src/map7_s03_boss_motion.c is the
#  i386 equivalent; map7_s03's boss code resolves the data from the exe side,
#  exactly like the PC DLL does.)
# NOTE: pc_config is deliberately NOT excluded. It is SDL-free (stdio only) and
# carries g_PcConfig's full default initializer plus the key=value parser, so the
# Xbox inherits every PC default automatically as the config struct grows, and
# users get a config file on the console without a launcher (see main_xbox.c).
# Xbox-specific overrides are applied after the load in xbox_compat_globals.c.
# pc_timing is NOT excluded either: PC_Tick30HzReady gates the classic-combat
# attack latch, run-release skid and the map1_s01 locker event; the old
# return-0 stub silently froze all three. It is SDL-free (g_DeltaTime only).
PCPORT_HAL_EXCLUDE := main_pc pc_combat pc_console_cmd pc_crash pc_quicksave \
	dbg_overlay warning_screen hires_override fs_pc dll_loader \
	map_overlay_loader map_registry xa_player \
	control_style pc_mouse_cursor \
	combat_target \
	miniz tex_pack \
	map7_s03_boss_motion
PCPORT_REUSE := $(filter-out $(foreach f,$(PCPORT_HAL_EXCLUDE),$(PCPORT)/src/$(f).c),\
	$(wildcard $(PCPORT)/src/*.c))

# PSX HAL stubs (libgs scene graph, libsnd/libds/libapi shims, zero-stub data +
# func bodies). map_overlay_stub excluded: map0_s00 provides g_MapOverlayHeader.
PCPORT_STUBS := \
	$(PCPORT)/src/stubs/libgs_stub.c \
	$(PCPORT)/src/stubs/libsnd_stub.c \
	$(PCPORT)/src/stubs/libds_stub.c \
	$(PCPORT)/src/stubs/libapi_stub.c \
	$(PCPORT)/src/stubs/data_stubs.c \
	$(PCPORT)/src/stubs/func_stubs.c

# Per-map compile define (mirrors CMake set_source_files_properties). The C
# pattern rule appends $(CFLAGS), so a target-specific addition scopes it to the
# map TUs only. Covers the shared chara/particle code they #include.
MAP_OBJS := $(addsuffix .obj,$(basename $(MAP_SRCS)))
$(MAP_OBJS): CFLAGS += -DMAP0_S00 -DSH_MAP_NAME=map0_s00

# USB host stack for the controller — scoped to pad_xbox.c (the headers/config
# define are nxdk-USB-specific and shouldn't leak into the rest of the build).
# The prebuilt $(NXDK_DIR)/lib/nxdk_usb.lib is linked below.
$(XBOX_PORT)/src/pad_xbox.obj: CFLAGS += \
	-I$(NXDK_DIR)/lib/usb/libusbohci/inc -I$(NXDK_DIR)/lib/usb/libusbohci_xbox \
	-DUSBH_USE_EXTERNAL_CONFIG=\"usbh_config_xbox.h\"

# RXDK DirectSound headers — scoped to the dsound driver TU only so they don't
# leak into the rest of the build. The xtl.h shim lives in $(XBOX_PORT)/include
# (on the global include path, searched first) so it wins over RXDK's xtl.h.
$(XBOX_PORT)/src/dsound_xbox.obj: CFLAGS += -I$(XBOX_PORT)/src/dsound/rxdk_include

# --- Sources ----------------------------------------------------------------
# Xbox platform shell + NV2A/PSX-libgpu HAL.
XBOX_SRCS = \
	$(XBOX_PORT)/src/main_xbox.c \
	$(XBOX_PORT)/src/crash_xbox.c \
	$(XBOX_PORT)/src/sh_log_xbox.c \
	$(XBOX_PORT)/src/fs_xbox.c \
	$(XBOX_PORT)/src/pgxp_stub.c \
	$(XBOX_PORT)/src/gte_selftest.c \
	$(XBOX_PORT)/src/gpu_nv2a.c \
	$(XBOX_PORT)/src/gpu_xbox.c \
	$(XBOX_PORT)/src/sdl_compat_xbox.c \
	$(XBOX_PORT)/src/psx_libgpu_xbox.c \
	$(XBOX_PORT)/src/xbox_compat_stubs.c \
	$(XBOX_PORT)/src/xbox_compat_globals.c \
	$(XBOX_PORT)/src/xbox_pcfeature_stubs.c \
	$(XBOX_PORT)/src/map_xbox.c \
	$(XBOX_PORT)/src/map7_s03_boss_motion.c \
	$(XBOX_PORT)/src/libc_compat_xbox.c \
	$(XBOX_PORT)/src/pad_xbox.c \
	$(XBOX_PORT)/src/cd_xbox.c \
	$(XBOX_PORT)/src/mcard_xbox.c \
	$(XBOX_PORT)/src/xa_xbox.c \
	$(XBOX_PORT)/src/fmv_xbox.c \
	$(XBOX_PORT)/src/avi_read.c \
	$(XBOX_PORT)/src/psx_vram.c \
	$(XBOX_PORT)/src/gte_diag.c \
	$(XBOX_PORT)/src/audio_xbox.c \
	$(XBOX_PORT)/src/dsound_xbox.c \
	$(XBOX_PORT)/src/dsound_bridge.c \
	$(XBOX_PORT)/src/msvc_compat.c

# PC port's STR demuxer + software MDEC decoder (pure C, integer bitstream work
# + x87-safe float YUV; no SDL/GL/x64 assumptions). Compiled IN PLACE, unmodified
# — fmv_xbox.c provides the Xbox player around them. Their MDEC_TRACE=2 error
# logging writes to g_ShDebugLog (sh_log_xbox.c), so it lands in silenthill.log.
FMV_SRCS = \
	$(PCPORT)/src/fmv/mdec.c \
	$(PCPORT)/src/fmv/str_demux.c

SRCS = \
	$(XBOX_SRCS) \
	$(FMV_SRCS) \
	$(MAIN_SRCS) \
	$(BODYPROG_SRCS) \
	$(SCREEN_SRCS) \
	$(MAP_SRCS) \
	$(PCPORT_REUSE) \
	$(PCPORT_STUBS) \
	$(GTE_SRCS)

# Cg shaders compiled to .inl by nxdk's vp20/fp20 host tools, #included by
# gpu_nv2a.c. (vs.inl <- vs.vs.cg, ps.inl <- ps.ps.cg)
SHADER_OBJS = $(XBOX_PORT)/src/vs.inl $(XBOX_PORT)/src/ps.inl

# --- RXDK DirectSound: link the prebuilt (debug-stripped) XDK objects --------
# Hardware audio path: dsound_xbox.c drives these via the dsound_bridge.c
# (stdcall<->cdecl) + msvc_compat.c (x87 CRT intrinsics) shims. The objects were
# extracted from the XDK dsound.lib and pre-stripped of .debug$F/.debug$S (which
# crash lld). Order matters (dsapi/globals first). /safeseh:no: the MSVC objects
# reference SEH (__except_handler3 is provided by msvc_compat.c).
DSOUND_OBJS_DIR = $(XBOX_PORT)/src/dsound_objs
DSOUND_OBJS = \
	$(DSOUND_OBJS_DIR)/dsapi.obj \
	$(DSOUND_OBJS_DIR)/globals.obj \
	$(DSOUND_OBJS_DIR)/mcpxcore.obj \
	$(DSOUND_OBJS_DIR)/mcpvoice.obj \
	$(DSOUND_OBJS_DIR)/mcpstrm.obj \
	$(DSOUND_OBJS_DIR)/mcpbuf.obj \
	$(DSOUND_OBJS_DIR)/mcpapu.obj \
	$(DSOUND_OBJS_DIR)/gpdsp.obj \
	$(DSOUND_OBJS_DIR)/epdsp.obj \
	$(DSOUND_OBJS_DIR)/dspdma.obj \
	$(DSOUND_OBJS_DIR)/dsmath.obj \
	$(DSOUND_OBJS_DIR)/dscommon.obj \
	$(DSOUND_OBJS_DIR)/heap.obj \
	$(DSOUND_OBJS_DIR)/ac97.obj \
	$(DSOUND_OBJS_DIR)/dsperf.obj \
	$(DSOUND_OBJS_DIR)/dsoundi.obj \
	$(DSOUND_OBJS_DIR)/hrtf.obj \
	$(DSOUND_OBJS_DIR)/i3dl2.obj \
	$(DSOUND_OBJS_DIR)/cipher.obj \
	$(DSOUND_OBJS_DIR)/ac97xmo.obj \
	$(DSOUND_OBJS_DIR)/wavexmo.obj \
	$(DSOUND_OBJS_DIR)/wavfileio.obj
NXDK_LDFLAGS += $(DSOUND_OBJS)
NXDK_LDFLAGS += /safeseh:no
NXDK_LDFLAGS += /errorlimit:0
# Linker map for crash telemetry: nxdk links at -fixed -base:0x00010000 and CXBE
# keeps the base, so a [FATAL] eip=%08x from crash_xbox.c resolves directly
# against this file (no rebasing needed). NOTE: "-map:" (dash) — a "/map:" slash
# flag gets POSIX-path-mangled by MSYS2 make into "C:\msys64\map;...".
NXDK_LDFLAGS += -map:$(XBOX_PORT)/bin/default.map

# nxdk's `clean: $(CLEANRULES)` rule expands CLEANRULES at include time, so this
# hook (defined below, after the include) must be registered here.
CLEANRULES += clean-maps

include $(NXDK_DIR)/Makefile

# Link the prebuilt USB host lib (pad_xbox.c) — extra prerequisite merged into the
# nxdk main.exe rule so it joins $^ on the link line. MUST come AFTER the include:
# placed before it, this rule became make's first target (default goal), so `make`
# built only main.exe and skipped the CXBE step -> a stale default.xbe.
main.exe: $(NXDK_DIR)/lib/nxdk_usb.lib

# ============================================================================
# Additional statically-linked map overlays (symbol-prefixed)
# ============================================================================
# Every map beyond map0_s00 is compiled exactly like the PC port's map DLLs
# (all of src/maps/<name>/*.c + the map's extracted_data TU, with -DMAP<N>_S<M>
# -DSH_MAP_NAME=<name>), then every DEFINED extern symbol of that map is renamed
# with llvm-objcopy --redefine-syms to <name>_<sym>. Applying the same rename
# list to all of the map's objs renames definitions AND intra-map references
# consistently; references to SHARED game symbols (undefined in the map objs)
# are untouched and resolve against bodyprog/pc_port code — the same binding a
# PC map DLL gets from the exe's import lib. This kills the 500+ cross-map
# duplicate-symbol collisions (each map #includes the shared player/particle/
# chara sources). map0_s00 stays UNPREFIXED (current behavior).
#
# The map's header symbol g_MapOverlayHeader_<name> gets prefixed too — it
# becomes <name>_g_MapOverlayHeader_<name>; map_xbox.c externs the prefixed
# name for its registry table.
#
# Incremental safety: raw .obj files (next to their sources, built by nxdk's
# %.obj: %.c rule) are never modified in place; objcopy writes prefixed copies
# to build/maps/<name>/, so re-running the build never double-prefixes. The
# <name>.syms rename list is regenerated whenever any raw obj of the map
# changes, and all prefixed objs depend on it.
#
# Each map's prefixed objs are archived into build/maps/<name>.lib, linked with
# -wholearchive: (forces ALL members in — some map objs are reached only via
# .CRT$XCU constructors, e.g. the anim_info variable-duration patches, and lazy
# archive semantics would drop them). One lib per map also keeps the linker
# command line short (42 lib paths instead of ~350 obj paths, which would blow
# the Win32 32K command-line limit).
#
# NOTE: symbol prefixing = PSX overlay semantics: each overlay carries its own
# copy of the shared AI/particle/player code+data, exactly like on PSX where
# each map overlay is a self-contained binary at 0x800C9xxx.

EXTRA_MAPS := \
	map0_s01 map0_s02 \
	map1_s00 map1_s01 map1_s02 map1_s03 map1_s04 map1_s05 map1_s06 \
	map2_s00 map2_s01 map2_s02 map2_s03 map2_s04 \
	map3_s00 map3_s01 map3_s02 map3_s03 map3_s04 map3_s05 map3_s06 \
	map4_s00 map4_s01 map4_s02 map4_s03 map4_s04 map4_s05 map4_s06 \
	map5_s00 map5_s01 map5_s02 map5_s03 \
	map6_s00 map6_s01 map6_s02 map6_s03 map6_s04 map6_s05 \
	map7_s00 map7_s01 map7_s02 map7_s03

MAPBUILD := $(XBOX_PORT)/build/maps

# map4_s02 -> MAP4_S02 (map names are all lowercase mapN_sMM, so two substs do)
mapdef = $(subst map,MAP,$(subst _s,_S,$(1)))

define MAP_OVERLAY_template
MAP_RAW_SRCS_$(1) := $$(wildcard $$(DECOMP)/src/maps/$(1)/*.c) \
                     $$(wildcard $$(PCPORT)/build_gen/extracted_data/$(1)_extracted_data.c)
MAP_RAW_OBJS_$(1) := $$(addsuffix .obj,$$(basename $$(MAP_RAW_SRCS_$(1))))
MAP_PFX_OBJS_$(1) := $$(addprefix $$(MAPBUILD)/$(1)/,$$(notdir $$(MAP_RAW_OBJS_$(1))))

$$(MAP_RAW_OBJS_$(1)): CFLAGS += -D$$(call mapdef,$(1)) -DSH_MAP_NAME=$(1)

$$(MAPBUILD)/$(1)/$(1).syms: $$(MAP_RAW_OBJS_$(1))
	@echo "[ MAPSYMS  ] $$@"
	$$(VE)mkdir -p $$(MAPBUILD)/$(1) && \
		$$(XBOX_PORT)/tools/gen_map_syms.sh $(1) '$$@' $$^

$$(MAPBUILD)/$(1)/%.obj: $$(DECOMP)/src/maps/$(1)/%.obj $$(MAPBUILD)/$(1)/$(1).syms
	$$(VE)llvm-objcopy --redefine-syms='$$(MAPBUILD)/$(1)/$(1).syms' '$$<' '$$@'

$$(MAPBUILD)/$(1)/%.obj: $$(PCPORT)/build_gen/extracted_data/%.obj $$(MAPBUILD)/$(1)/$(1).syms
	$$(VE)llvm-objcopy --redefine-syms='$$(MAPBUILD)/$(1)/$(1).syms' '$$<' '$$@'

$$(MAPBUILD)/$(1).lib: $$(MAP_PFX_OBJS_$(1))
	@echo "[ MAPLIB   ] $$@"
	$$(VE)rm -f '$$@' && llvm-ar rcs '$$@' $$^

MAP_LIBS     += $$(MAPBUILD)/$(1).lib
NXDK_LDFLAGS += -wholearchive:$$(MAPBUILD)/$(1).lib
endef

$(foreach m,$(EXTRA_MAPS),$(eval $(call MAP_OVERLAY_template,$(m))))

# Normal (not order-only) prerequisites: a changed map source must propagate
# lib -> main.exe -> default.xbe. The libs also land on the link line via $^,
# but that second (bare) mention is lazy and pulls nothing — every member is
# already loaded by the -wholearchive: flag above.
main.exe: $(MAP_LIBS)

# Header-dependency files for the raw map objs (they are not in SRCS, so nxdk's
# own DEPS -include doesn't cover them).
EXTRA_MAP_DEPS := $(foreach m,$(EXTRA_MAPS),$(patsubst %.obj,%.c.d,$(MAP_RAW_OBJS_$(m))))
-include $(EXTRA_MAP_DEPS)

.PHONY: clean-maps
clean-maps:
	rm -rf $(MAPBUILD)
	for d in $(EXTRA_MAPS); do \
		rm -f $(DECOMP)/src/maps/$$d/*.obj $(DECOMP)/src/maps/$$d/*.c.d \
		      $(PCPORT)/build_gen/extracted_data/$${d}_extracted_data.obj \
		      $(PCPORT)/build_gen/extracted_data/$${d}_extracted_data.c.d; \
	done
