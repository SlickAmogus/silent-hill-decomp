# Silent Hill 1 - Original Xbox (NXDK / NV2A) port
#
# GNU-make build wrapping the nxdk toolchain -> default.xbe. Invoke via
# build_xbox.sh (sets NXDK_DIR + PATH + scrubs host MSVC INCLUDE/LIB).
#
# MILESTONE 1: build only the platform shell (main_xbox.c + log shim) to a
# booting black-screen xbe. Shared game code + reused pc_port files get added to
# SRCS in the next milestone.

XBE_TITLE = SilentHill
NXDK_DIR  ?= $(CURDIR)/nxdk
# GEN_XISO intentionally unset: the default target then builds only default.xbe
# (boots directly in xemu / via HDD). Packing an .iso pulls in nxdk's extract-xiso
# host tool, which is built with CMake->gcc and hits the same temp-file bug as the
# other host tools; wire it up (with CXX=clang++) when an ISO is actually needed.

# nxdk-cc subprocesses need NXDK_DIR; MSYS2 make does not always propagate it.
export NXDK_DIR

# --- Repo layout ------------------------------------------------------------
XBOX_PORT = $(CURDIR)
PCPORT    = $(CURDIR)/../pc_port
DECOMP    = $(CURDIR)/..
PSYCROSS  = $(PCPORT)/PsyCross

# --- Shared compile flags ---------------------------------------------------
# nxdk uses SEPARATE flag vars per language (NXDK_CFLAGS for .c, NXDK_CXXFLAGS
# for .cpp), so defines + include paths must go into BOTH or C++ TUs (e.g. the
# PsyCross GTE) won't see them.
#
# Xbox-specific game-code paths sit behind #ifdef SH_XBOX_PORT. (A shared
# SH_NATIVE_PORT macro for "not-PSX" fixes common to PC+Xbox is planned but not
# defined yet — it will be introduced when the first such fix is migrated.)
SH_CPPFLAGS  = -DSH_XBOX_PORT
SH_CPPFLAGS += -I$(XBOX_PORT)/include
SH_CPPFLAGS += -I$(PCPORT)/include   # shared sh_log.h, psx_memory.h, gpu_gte_pc.h, ...
# PsyCross PSX-compatible headers: <libgte.h> etc. and "psx/..."/"PsyX/..." forms.
SH_CPPFLAGS += -I$(PSYCROSS)/include/psx
SH_CPPFLAGS += -I$(PSYCROSS)/include

# Explicit nxdk include paths using make's $(NXDK_DIR): MSYS2 make.exe does not
# propagate NXDK_DIR into nxdk-cc's shell, so nxdk-cc's own -I${NXDK_DIR}/...
# flags would expand empty. (See Duke port build notes.)
SH_CPPFLAGS += -I$(NXDK_DIR)/lib/winapi
SH_CPPFLAGS += -I$(NXDK_DIR)/lib
SH_CPPFLAGS += -I$(NXDK_DIR)/lib/xboxrt/libc_extensions
SH_CPPFLAGS += -isystem $(NXDK_DIR)/lib/pdclib/include
SH_CPPFLAGS += -I$(NXDK_DIR)/lib/pdclib/platform/xbox/include
SH_CPPFLAGS += -I$(NXDK_DIR)/lib/xboxrt/vcruntime

NXDK_CFLAGS   += $(SH_CPPFLAGS)
NXDK_CXXFLAGS += $(SH_CPPFLAGS)

# --- Reused PsyCross software GTE (platform-agnostic; replaces MIPS GTE asm) -
# inline_c.c = cop2 MTC2/CTC2/MFC2 interface, PsyX_GTE.cpp = the GTE math,
# libgte.c = high-level libgte API (RotTransPers, matrices), abs.c = helpers.
# (half_float.cpp is PGXP-only and unreferenced by the GTE -> excluded.)
GTE_SRCS = \
	$(PSYCROSS)/src/psx/inline_c.c \
	$(PSYCROSS)/src/psx/libgte.c \
	$(PSYCROSS)/src/psx/abs.c \
	$(PSYCROSS)/src/gte/PsyX_GTE.cpp

# --- Sources ----------------------------------------------------------------
SRCS = \
	$(XBOX_PORT)/src/main_xbox.c \
	$(XBOX_PORT)/src/sh_log_xbox.c \
	$(XBOX_PORT)/src/fs_xbox.c \
	$(XBOX_PORT)/src/pgxp_stub.c \
	$(XBOX_PORT)/src/gte_selftest.c \
	$(XBOX_PORT)/src/gpu_nv2a.c \
	$(XBOX_PORT)/src/gpu_xbox.c \
	$(GTE_SRCS)

# Cg shaders compiled to .inl by nxdk's vp20/fp20 host tools, #included by
# gpu_nv2a.c. (vs.inl <- vs.vs.cg, ps.inl <- ps.ps.cg)
SHADER_OBJS = $(XBOX_PORT)/src/vs.inl $(XBOX_PORT)/src/ps.inl

include $(NXDK_DIR)/Makefile
