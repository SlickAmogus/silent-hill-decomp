#include "sh_version.h"

/* Windows executable icon. The lowest-numbered ICON resource is what Explorer,
 * the taskbar, and the window title bar use for SilentHillPC.exe. */
1 ICON "app_icon.ico"

/* Win32 version info. SH_VER_* come from the generated sh_version.h, which is
 * rewritten every build (build = git commit count, revision = HHMM), so the
 * File Version advances with each build. */
1 VERSIONINFO
FILEVERSION    SH_VER_MAJOR, SH_VER_MINOR, SH_VER_BUILD, SH_VER_REV
PRODUCTVERSION SH_VER_MAJOR, SH_VER_MINOR, 0, 0
FILEOS         0x40004L
FILETYPE       0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",     "KONAMI"
            VALUE "FileDescription", "Silent Hill PC port based on decompiled PSX code. Source: https://github.com/SlickAmogus/silent-hill-decomp"
            VALUE "FileVersion",     SH_VER_FILE_STR
            VALUE "LegalCopyright",  "KONAMI"
            VALUE "ProductName",     "Silent Hill"
            VALUE "ProductVersion",  SH_VER_PROD_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
