<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{E4F67033-83AF-4DAE-9DCE-5CC62E6B1F6D}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SilentHillPC_Launcher</RootNamespace>
    <AssemblyName>SilentHillPC_Launcher</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- 64-bit process so the embedded x64 UnRAR.dll (RarExtractor) loads. -->
    <Prefer32Bit>false</Prefer32Bit>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- 64-bit process so the embedded x64 UnRAR.dll (RarExtractor) loads. -->
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <!-- Ship a real manifest (asInvoker, supported-OS, stable identity) to lower
         antivirus false-positive heuristics. See docs/Launcher_Antivirus_Notes.md. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="DisplayModes.cs" />
    <Compile Include="Form1.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Form1.Designer.cs">
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
    <Compile Include="ConfigManager.cs" />
    <Compile Include="DiscProbe.cs" />
    <Compile Include="BinExtractor.cs" />
    <Compile Include="TimConverter.cs" />
    <Compile Include="ClutComposer.cs" />
    <Compile Include="ControlsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Program.cs" />
    <Compile Include="UpdateChecker.cs" />
    <Compile Include="LauncherSettings.cs" />
    <Compile Include="ChangelogViewer.cs" />
    <Compile Include="BuildSettingsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="RepoSettingsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="ModManager.cs" />
    <Compile Include="ModManagerForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="ProgressDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="RarExtractor.cs" />
    <Compile Include="SevenZipExtractor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <!-- Embed the real pc_port/config.cfg so the launcher can regenerate a
         missing config.cfg with the full detailed template; the link keeps
         it in sync with the repo copy at build time. -->
    <EmbeddedResource Include="..\..\config.cfg">
      <Link>DefaultConfig.cfg</Link>
      <LogicalName>SilentHillPC_Launcher.DefaultConfig.cfg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Form1.resx">
      <DependentUpon>Form1.cs</DependentUpon>
    </EmbeddedResource>
    <!-- Vendored unrar built as an x64 DLL (RAR4/RAR5/solid). Embedded in the exe
         so RarExtractor can materialize it to a temp path and LoadLibrary it — no
         dependency on the DLL being copied next to wherever the launcher runs. -->
    <EmbeddedResource Include="UnRAR.dll">
      <LogicalName>SilentHillPC_Launcher.UnRAR.dll</LogicalName>
    </EmbeddedResource>
    <!-- Standalone 7-Zip console tool (LGPL, (C) Igor Pavlov). Embedded in the exe
         so SevenZipExtractor can materialize it to a temp path and run it as a
         separate process to unpack .zip/.7z texture packs (every compression
         method, unlike miniz/.NET Store+Deflate). Its license ships as
         LICENSE-7zip.txt beside the launcher. -->
    <EmbeddedResource Include="7za.exe">
      <LogicalName>SilentHillPC_Launcher.7za.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <SubType>Designer</SubType>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Include="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <None Include="app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources\launcher.png" />
    <None Include="Resources\manager.png" />
    <None Include="Resources\manager_clicked.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="favicon.ico" />
    <!-- 7-Zip's LGPL/BSD notice, shipped beside the launcher (redistribution of
         7za.exe must reproduce this). -->
    <Content Include="LICENSE-7zip.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>