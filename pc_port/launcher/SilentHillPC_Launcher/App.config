<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <runtime>
        <!-- Pin long-path support explicitly (the 4.7.2 target's default, but a
             machine-wide or inherited override would break >MAX_PATH texture-pack
             paths in System.IO — DuckStation texupload-* names are ~110 chars on
             top of users' nested extract folders). -->
        <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
    </runtime>
</configuration>